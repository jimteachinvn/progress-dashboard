SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Settings -> Database -> Connection string -> URI (use the pooler "Session" connection
# on port 5432, or "Transaction" pooler on 6543 both work for this one-off script).
# This is only used locally to run schema migrations; it is never sent anywhere else.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
